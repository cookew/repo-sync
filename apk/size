#!/bin/bash

set -euo pipefail

total=0
dest="$(mktemp -d)"

excludes="--exclude=aarch64 --exclude=armhf --exclude=armv7 --exclude=mips64 --exclude=ppc64le --exclude=riscv64 --exclude=s390x --exclude=x86"

for dir in v3.14 v3.15; do
  old_total="$total"
  src="rsync://rsync.alpinelinux.org/alpine/$dir/"
  size=$(rsync -a -n --stats "${src}" "${dest}" "${excludes}" | grep '^Total file size' | tr -d ',' | awk '{ print $4 }')
  total=$(("${old_total}" + "${size}"))
  echo "$dir: $size" | awk '{ print $1 sprintf("%.1f", $2/1073741824) }'
done

echo "total: $total" | awk '{ print $1 sprintf("%.1f", $2/1073741824) }'
rm -r "${dest}"
